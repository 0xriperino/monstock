{
  "name": "stockback-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "demo:local": "tsx scripts/local-demo.ts",
    "abis": "node ../contracts/script/export-abis.mjs",
    "test:browser": "node scripts/browser-e2e.mjs",
    "test:launch": "node --import tsx scripts/launch-dialog.test.mjs",
    "test:trading": "node --import tsx scripts/trading.test.mjs",
    "test:client": "tsx --test src/lib/stockback.test.ts",
    "demo:testnet": "node --env-file=../.env --import tsx scripts/testnet-demo.ts",
    "test:rpc": "tsx --test src/lib/rpc.test.ts",
    "test:assets": "tsx scripts/multi-assets.ts",
    "test:assets:browser": "node scripts/multi-assets-browser.mjs",
    "test:native:browser": "node --import tsx scripts/native-browser.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3",
    "viem": "^2.57.11",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
